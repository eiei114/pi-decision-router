{
  "name": "pi-decision-router",
  "version": "0.3.2",
  "description": "Route Pi questions and confirmations to a child Pi agent with deterministic fallback and JSONL audit logging.",
  "type": "module",
  "license": "MIT",
  "author": "Eisuke Kawano",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "decision-router",
    "agent",
    "automation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/eiei114/pi-decision-router"
  },
  "bugs": {
    "url": "https://github.com/eiei114/pi-decision-router/issues"
  },
  "homepage": "https://github.com/eiei114/pi-decision-router#readme",
  "files": [
    "extensions/",
    "lib/",
    "skills/",
    "docs/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs tests/release-trigger-contract.test.mjs",
    "smoke:pi": "node scripts/pi-sdk-smoke.mjs",
    "ci": "npm run typecheck && npm test && npm run smoke:pi && npm run pack:check",
    "pack:check": "npm pack --dry-run"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "@types/node": "^26.0.0",
    "typebox": "latest",
    "typescript": "^7.0.2"
  }
}
